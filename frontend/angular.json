{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "trato-frontend": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/trato-frontend",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              { "glob": "**/*", "input": "src/assets", "output": "assets" },
              "src/favicon.ico"
            ],
            "styles": [
              "src/styles.css",
              "src/assets/css/style.css",
              "src/assets/css/layout.css",
              "src/assets/css/components.css",
              "src/assets/css/forms.css",
              "src/assets/css/tables.css",
              "src/assets/css/pages.css",
              "src/assets/css/landing.css",
              "src/assets/css/agenda.css",
              "src/assets/css/print.css"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                { "type": "initial", "maximumWarning": "2mb", "maximumError": "4mb" }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": { "buildTarget": "trato-frontend:build:production" },
            "development": { "buildTarget": "trato-frontend:build:development" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
